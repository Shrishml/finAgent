# FinAgent Configuration

[llm]
default = "auto"            # "auto", "gemini", "kiro", or "api" — auto picks whatever CLI is installed
# parsing = "kiro"        # override for PDF extraction tasks
# reasoning = "kiro"      # override for financial analysis tasks

[llm.api]
# gemini_key = ""         # only needed if default = "api"
# claude_key = ""

[server]
host = "0.0.0.0"
port = 8000

[database]
# SQLite (default) - uses local file
# url = "sqlite:///data/finagent.db"

# PostgreSQL - uncomment and configure for production
# url = "postgresql://user:password@localhost:5432/finagent"
